# Local default. Keep remote database access disabled unless intentionally hosting the API.
SILVERSTONE_DATABASE_URL=postgresql://silverstone:local-only@127.0.0.1:55432/silverstone_dev
SILVERSTONE_ALLOW_REMOTE_DATABASE=false
SILVERSTONE_ALLOW_REMOTE_MIGRATIONS=false
SILVERSTONE_ALLOW_REMOTE_BOOTSTRAP=false

# Set a randomly generated value of at least 32 characters. Never commit the real value.
SILVERSTONE_JWT_SECRET=

PORT=8800
HOST=127.0.0.1
SILVERSTONE_RATE_LIMIT=30

# Render + Supabase example (configure these as Render environment variables, not in Git):
# SILVERSTONE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# SILVERSTONE_ALLOW_REMOTE_DATABASE=true
# HOST=0.0.0.0
#
# Only enable this for an intentional migration run after reviewing the target database.
# SILVERSTONE_ALLOW_REMOTE_MIGRATIONS=true
#
# One-time first main-agent bootstrap. Keep the flag false during normal runtime.
# SILVERSTONE_ALLOW_REMOTE_BOOTSTRAP=true
# SILVERSTONE_BOOTSTRAP_EMAIL=main-agent@example.com
# SILVERSTONE_BOOTSTRAP_NAME=Main Agent Name
# SILVERSTONE_BOOTSTRAP_PHONE=+255700000000
# SILVERSTONE_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
#
# Upstash/Redis is supporting infrastructure, not the agent identity or PIN store.
# Preferred single URL:
# SILVERSTONE_REDIS_URL=rediss://default:PASSWORD@HOST:PORT
# Existing split Upstash/Redis variables are also supported:
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=
